# source: spec
# spec: docs/protocol/diag-header.md#client-message-headers
# provenance: PV-0030, PV-0031, PV-0032, PV-0033, PV-0034, PV-0035, PV-0036, PV-0037, PV-0038, PV-0044, PV-0050, PV-0054, PV-0300
# kind: diag-header
# description: DIAG header of the client's first message (it follows the DP header): mode 0, com_flag INI only, every other byte 0.
# derivation: Pattern PV-0300; 0x10 is INI (PV-0044) at offset 1 (PV-0032); err_no 0 and compress 0 give an item body (PV-0050, PV-0054). The first-message encoder (IMPL-DH-9) must produce exactly these bytes.
# expect.error: none
# expect.mode: 0x00
# expect.com_flag: 0x10
# expect.mode_stat: 0x00
# expect.err_no: 0x00
# expect.msg_type: 0x00
# expect.msg_info: 0x00
# expect.msg_rc: 0x00
# expect.compress: 0x00
# expect.com_flag.names: INI
# expect.body: items
# expect.client_message: first
hex:
00 10 00 00 00 00 00 00                           # mode com_flag mode_stat err_no msg_type msg_info msg_rc compress
