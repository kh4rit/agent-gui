# source: spec
# spec: docs/protocol/diag-header.md#error-messages
# provenance: PV-0030, PV-0031, PV-0032, PV-0033, PV-0034, PV-0035, PV-0036, PV-0037, PV-0038, PV-0050, PV-0054, PV-0303
# kind: diag-header
# description: err_no = 0x01 with compress 0: an error body follows the header (error text, 0x0C, items), not a plain item sequence.
# derivation: err_no at offset 3 (PV-0034) is non-zero, so the body is an error body (PV-0054, PV-0303; v1 replaces v0's reading R-DH-4); compress 0 (PV-0050); the mode value is arbitrary. The body itself is not included; the diag-error-body kind splits it, and the text's byte order is gap #8.
# expect.error: none
# expect.mode: 0x00
# expect.com_flag: 0x00
# expect.mode_stat: 0x00
# expect.err_no: 0x01
# expect.msg_type: 0x00
# expect.msg_info: 0x00
# expect.msg_rc: 0x00
# expect.compress: 0x00
# expect.com_flag.names: none
# expect.body: error-text
hex:
00 00 00 01 00 00 00 00                           # mode com_flag mode_stat err_no msg_type msg_info msg_rc compress
