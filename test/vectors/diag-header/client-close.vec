# source: spec
# spec: docs/protocol/diag-header.md#client-message-headers
# provenance: PV-0030, PV-0031, PV-0032, PV-0033, PV-0034, PV-0035, PV-0036, PV-0037, PV-0038, PV-0041, PV-0050, PV-0054, PV-0302
# kind: diag-header
# description: The client's close message, which is this 8-byte header alone: com_flag EOC only, compress 0.
# derivation: Pattern PV-0302; 0x02 is EOC (PV-0041) at offset 1 (PV-0032); err_no 0 and compress 0 (PV-0050, PV-0054) give an item body, here empty because the message ends after the header. The close encoder (IMPL-DH-9) must produce exactly these bytes.
# expect.error: none
# expect.mode: 0x00
# expect.com_flag: 0x02
# expect.mode_stat: 0x00
# expect.err_no: 0x00
# expect.msg_type: 0x00
# expect.msg_info: 0x00
# expect.msg_rc: 0x00
# expect.compress: 0x00
# expect.com_flag.names: EOC
# expect.body: items
# expect.client_message: close
hex:
00 02 00 00 00 00 00 00                           # mode com_flag mode_stat err_no msg_type msg_info msg_rc compress
