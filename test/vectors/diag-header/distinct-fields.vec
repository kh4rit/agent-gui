# source: spec
# spec: docs/protocol/diag-header.md#layout
# provenance: PV-0030, PV-0031, PV-0032, PV-0033, PV-0034, PV-0035, PV-0036, PV-0037, PV-0038, PV-0041, PV-0045, PV-0050, PV-0054
# kind: diag-header
# description: Distinct values in every field; com_flag 0x22 combines EOC and CAS.
# derivation: Each byte sits at its field's offset (PV-0031..PV-0038); 0x22 = 0x02 (EOC, PV-0041) | 0x20 (CAS, PV-0045); err_no 0 and compress 0 give an item body.
# expect.error: none
# expect.mode: 0x11
# expect.com_flag: 0x22
# expect.mode_stat: 0x33
# expect.err_no: 0x00
# expect.msg_type: 0x55
# expect.msg_info: 0x66
# expect.msg_rc: 0x77
# expect.compress: 0x00
# expect.com_flag.names: EOC,CAS
# expect.body: items
hex:
11 22 33 00 55 66 77 00                           # mode com_flag mode_stat err_no msg_type msg_info msg_rc compress
