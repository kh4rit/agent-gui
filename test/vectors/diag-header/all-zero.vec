# provenance: PV-0030, PV-0031, PV-0032, PV-0033, PV-0034, PV-0035, PV-0036, PV-0037, PV-0038, PV-0050, PV-0054
# kind: diag-header
# description: A DIAG header with every field 0: no flags, no error, not compressed, so items follow.
# derivation: Eight one-byte fields at offsets 0-7 (PV-0030..PV-0038); err_no 0 (PV-0054) and compress 0 (PV-0050) mean an item sequence follows.
# expect.error: none
# expect.mode: 0x00
# expect.com_flag: 0x00
# expect.mode_stat: 0x00
# expect.err_no: 0x00
# expect.msg_type: 0x00
# expect.msg_info: 0x00
# expect.msg_rc: 0x00
# expect.compress: 0x00
# expect.com_flag.names: none
# expect.body: items
hex:
00 00 00 00 00 00 00 00                           # mode com_flag mode_stat err_no msg_type msg_info msg_rc compress
