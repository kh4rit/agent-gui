# source: spec
# spec: docs/protocol/diag-header.md#flag-bits
# provenance: PV-0030, PV-0031, PV-0032, PV-0033, PV-0034, PV-0035, PV-0036, PV-0037, PV-0038, PV-0040, PV-0041, PV-0042, PV-0043, PV-0044, PV-0045, PV-0046, PV-0047, PV-0050, PV-0054
# kind: diag-header
# description: com_flag 0xFF: all eight flags set; a decoder reports every set bit (reading R-DH-2).
# derivation: com_flag at offset 1 (PV-0032) is the OR of all eight masks PV-0040..PV-0047; err_no 0 and compress 0 give an item body (PV-0054, PV-0050).
# expect.error: none
# expect.mode: 0x00
# expect.com_flag: 0xFF
# expect.mode_stat: 0x00
# expect.err_no: 0x00
# expect.msg_type: 0x00
# expect.msg_info: 0x00
# expect.msg_rc: 0x00
# expect.compress: 0x00
# expect.com_flag.names: EOS,EOC,NOP,EOP,INI,CAS,NNM,GRA
# expect.body: items
hex:
00 FF 00 00 00 00 00 00                           # mode com_flag mode_stat err_no msg_type msg_info msg_rc compress
