# source: spec
# spec: docs/protocol/items.md#ses
# provenance: PV-0100, PV-0405, PV-0110, PV-0420
# kind: simple-item-fields
# description: SES fields with distinct values; the filler bytes 12-13 are EE EE and must not show up in any field.
# derivation: Type 0x01 (PV-0405), 16-byte value (PV-0110) split per PV-0420: bytes 0..11 are the one-byte fields event_array..flag_1 (values 1..12), bytes 12-13 filler (EE EE, ignored per reading R-IT-12), byte 14 dim_row = 15, byte 15 dim_col = 16.
# expect.type: ses
# expect.field.event_array: 1
# expect.field.event_id_1: 2
# expect.field.event_id_2: 3
# expect.field.event_id_3: 4
# expect.field.event_id_4: 5
# expect.field.event_id_5: 6
# expect.field.screen_flag: 7
# expect.field.modal_number: 8
# expect.field.x_pos: 9
# expect.field.y_pos: 10
# expect.field.imode: 11
# expect.field.flag_1: 12
# expect.field.dim_row: 15
# expect.field.dim_col: 16
# expect.error: none
hex:
01                                                # type SES
01 02 03 04 05 06 07 08 09 0A 0B 0C EE EE 0F 10   # value: 01..0C, filler EE EE, 0F 10
