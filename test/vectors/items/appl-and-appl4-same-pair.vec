# kind: items
# description: The same (id, sid) DYNT / DYNT_ATOM once as APPL and once as APPL4: both items report the same id and sid.
# derivation: Item 1: 0x10, id 0x09, sid 0x02, u16 BE length 1 (PV-0102), value at 5 (PV-0402). Item 2 starts at 6: 0x12, id 0x09, sid 0x02, u32 BE length 1 (PV-0104), value at 6 + 7 = 13 (PV-0403). Dispatch uses (id, sid) only (IMPL-IT-9).
# expect.items: 2
# expect.item.1.type: appl
# expect.item.1.id: 0x09
# expect.item.1.sid: 0x02
# expect.item.1.id_name: DYNT
# expect.item.1.sid_name: DYNT_ATOM
# expect.item.1.offset: 5
# expect.item.1.length: 1
# expect.item.2.type: appl4
# expect.item.2.id: 0x09
# expect.item.2.sid: 0x02
# expect.item.2.id_name: DYNT
# expect.item.2.sid_name: DYNT_ATOM
# expect.item.2.offset: 13
# expect.item.2.length: 1
# expect.error: none
hex:
10                                                # type APPL
09                                                # id 0x09 DYNT
02                                                # sid 0x02 DYNT_ATOM
00 01                                             # length 1, u16 BE
AA                                                # value (opaque)
12                                                # type APPL4
09                                                # id 0x09 DYNT
02                                                # sid 0x02 DYNT_ATOM
00 00 00 01                                       # length 1, u32 BE
BB                                                # value (opaque)
