# source: spec
# spec: docs/protocol/items.md#appl4
# provenance: PV-0100, PV-0103, PV-0104, PV-0107, PV-0400, PV-0401, PV-0403, PV-0438, PV-0458
# kind: items
# description: APPL4 length bytes 00 00 00 02 mean 2 value bytes; a little-endian reading would run past the input.
# derivation: Type 0x12, id 0x09, sid 0x02, then 00 00 00 02 read as u32 BE (PV-0104) = 2; a little-endian reading gives 33554432 and a wrong truncated.
# expect.items: 1
# expect.item.1.type: appl4
# expect.item.1.id: 0x09
# expect.item.1.sid: 0x02
# expect.item.1.id_name: DYNT
# expect.item.1.sid_name: DYNT_ATOM
# expect.item.1.offset: 7
# expect.item.1.length: 2
# expect.error: none
hex:
12                                                # type APPL4
09                                                # id 0x09 DYNT
02                                                # sid 0x02 DYNT_ATOM
00 00 00 02                                       # length 2, u32 BE
AA BB                                             # value (opaque)
