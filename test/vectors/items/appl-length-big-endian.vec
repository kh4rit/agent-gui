# source: spec
# spec: docs/protocol/items.md#appl
# provenance: PV-0100, PV-0101, PV-0102, PV-0107, PV-0400, PV-0401, PV-0402, PV-0433, PV-0453
# kind: items
# description: APPL length bytes 00 01 mean 1 value byte; a little-endian reading (256) would run past the input.
# derivation: Type 0x10, id 0x04, sid 0x26, then 00 01 read as u16 BE (PV-0102) = 1, so one value byte follows and the walk ends cleanly; a little-endian reading gives 256 and a wrong truncated.
# expect.items: 1
# expect.item.1.type: appl
# expect.item.1.id: 0x04
# expect.item.1.sid: 0x26
# expect.item.1.id_name: ST_USER
# expect.item.1.sid_name: DIALOG_STEP_NUMBER
# expect.item.1.offset: 5
# expect.item.1.length: 1
# expect.error: none
hex:
10                                                # type APPL
04                                                # id 0x04 ST_USER
26                                                # sid 0x26 DIALOG_STEP_NUMBER
00 01                                             # length 1, u16 BE
AA                                                # value (opaque)
