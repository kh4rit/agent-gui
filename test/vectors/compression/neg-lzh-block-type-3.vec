# source: spec
# spec: docs/protocol/compression-lzh.md#block-header
# provenance: PV-0060, PV-0061, PV-0062, PV-0063, PV-0064, PV-0066, PV-0067, PV-0068, PV-0350, PV-0351, PV-0352, PV-0354, PV-0356
# kind: decompress
# description: A block of type 3, which is invalid.
# derivation: Header: length 1. Bits: 0-1 count 0; 2 final 1; 3-4 type 3 = 1,1; 5-7 zero, so byte 0 = 0x1C. Type 3 fails with bad-block-type (PV-0356).
# expect.error: bad-block-type
# expect.algorithm: lzh
# expect.uncompressed_length: 1
hex:
01 00 00 00                                       # uncompressed length, u32 LE
12                                                # algorithm byte
1F 9D                                             # magic
02                                                # byte 7
1C                                                # count 0, final 1, type 3
